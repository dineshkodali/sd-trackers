# =====================================================================
# SafeHaven Operations - Environment Variables Reference (.env.example)
# =====================================================================

# Server & Hosting
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Microsoft Azure Entra ID / Single Sign-On (SSO)
# ---------------------------------------------------------------------
AZURE_CLIENT_ID=
AZURE_TENANT_ID=common
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=common
VITE_AZURE_REDIRECT_URI=

# ---------------------------------------------------------------------
# Supabase Database & Auth (Backend credentials)
# ---------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# ---------------------------------------------------------------------
# SMTP Email Service
# ---------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SafeHaven Operations <noreply@safehavenops.org>"
SMTP_SECURE=false

# ---------------------------------------------------------------------
# AI Studio & Intelligence
# ---------------------------------------------------------------------
GEMINI_API_KEY=
