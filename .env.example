# =====================================================================
# SD Operations Platform - Environment Variables Reference (.env.example)
# =====================================================================

# Server & Hosting
PORT=3020
HOST_PORT=3020
NODE_ENV=development
APP_URL=https://trackers.sdcdms.co.uk
ALLOWED_ORIGINS=https://trackers.sdcdms.co.uk,http://trackers.sdcdms.co.uk,http://localhost:3020

# ---------------------------------------------------------------------
# Microsoft Azure Entra ID / Single Sign-On (SSO)
# ---------------------------------------------------------------------
AZURE_CLIENT_ID=
AZURE_TENANT_ID=common
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=common
VITE_AZURE_REDIRECT_URI=

# ---------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------
# Signing key for the built-in administrator session token.
# REQUIRED in production. If unset, a random key is generated per boot, so
# built-in administrator sessions stop validating after every restart.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN_SECRET=

# Comma-separated origins permitted to make credentialed cross-origin requests.
# The server also allows its own advertised addresses (localhost and each LAN IP
# on the bound port). Anything not listed receives no CORS headers.
# Example: ALLOWED_ORIGINS=https://trackers.sdcdms.co.uk,http://localhost:3020
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------
# Supabase Database & Auth (Backend credentials)
# ---------------------------------------------------------------------
# All records are stored in the live Supabase database; there is no local
# fallback. Without SUPABASE_URL + a secret key every save is refused.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection used ONLY to apply db/schema.sql (non-destructive,
# idempotent) on server start and by `npm run db:migrate`.
# Use the "Session pooler" string from Supabase > Connect > Session pooler:
#   postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres
# The direct host db.<project-ref>.supabase.co is IPv6-only and unreachable on
# most networks. If no endpoint is reachable, the server logs
# "[Migration NOT applied]" and pages whose tables are missing cannot save.
DATABASE_URL=
SUPABASE_DB_URL=

# ---------------------------------------------------------------------
# SMTP Email Service
# ---------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SD Operations <noreply@sdcommercial.co.uk>"
SMTP_SECURE=false
