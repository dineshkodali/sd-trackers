# =====================================================================
# SDTracker WebCRM — Production .gitignore
# =====================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs & Bundles
dist/
dist-ssr/
build/
coverage/
*.tsbuildinfo

# Environment & Secret Protection (NEVER COMMIT)
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Testing & QA Directories (Hidden from root & ignored on GitHub)
.testing/
testing/
test-results/
playwright-report/
"QA Testing & Results/test-results/"
"QA Testing & Results/playwright-report/"
"html results/"

# Agent, Claude, Swarm & Automation Directories (NEVER COMMIT)
.agents/
.claude/
.swarm/
.swarn/
.claude-flow/
.calude-flow/

# Vite, Turbo & Build Caches
.vite/
.turbo/
.cache/
.parcel-cache/
.npm/

# Scratch & Temporary Runtime Artifacts
scratch/
temp/
tmp/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
*.pdf

# OS & Editor Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
*.sublime-workspace
*.sublime-project
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
