import React, { useState, useEffect, useMemo } from 'react';
import {
  FileText,
  Plus,
  Search,
  Filter,
  CheckCircle,
  XCircle,
  Clock,
  AlertCircle,
  HelpCircle,
  Building,
  CreditCard,
  Scale,
  RefreshCw,
  Download,
  Eye,
  SlidersHorizontal,
  ChevronRight
} from 'lucide-react';
import { useApp } from '../../context/AppContext';
import { financeService } from '../../services/financeService';
import { FinanceBillModal } from './FinanceBillModal';
import { FinanceBillDetailModal } from './FinanceBillDetailModal';
import { FinanceVendorModal } from './FinanceVendorModal';
import type { FinanceBill, FinanceVendor, FinanceBillStatus } from '../../types/finance';

export interface FinanceViewProps {
  initialTab?: 'all' | 'awaiting_approval' | 'verification' | 'reconciliation' | 'payments' | 'vendors';
}

export const FinanceView: React.FC<FinanceViewProps> = ({ initialTab = 'all' }) => {
  const { properties, assignedSite, canAccessAllSites, isFinanceUser, canManageFinance } = useApp();

  const [activeTab, setActiveTab] = useState<'all' | 'awaiting_approval' | 'verification' | 'reconciliation' | 'payments' | 'vendors'>(initialTab);

  useEffect(() => {
    if (initialTab) {
      setActiveTab(initialTab);
    }
  }, [initialTab]);
  const [bills, setBills] = useState<FinanceBill[]>([]);
  const [vendors, setVendors] = useState<FinanceVendor[]>([]);
  const [isLoading, setIsLoading] = useState(true);

  // Filters
  const [selectedSite, setSelectedSite] = useState<string>('all');
  const [selectedStatus, setSelectedStatus] = useState<string>('all');
  const [selectedType, setSelectedType] = useState<string>('all');
  const [searchQuery, setSearchQuery] = useState<string>('');

  // Modals
  const [isBillModalOpen, setIsBillModalOpen] = useState(false);
  const [billToEdit, setBillToEdit] = useState<FinanceBill | null>(null);

  const [isDetailModalOpen, setIsDetailModalOpen] = useState(false);
  const [selectedBillId, setSelectedBillId] = useState<string | null>(null);

  const [isVendorModalOpen, setIsVendorModalOpen] = useState(false);
  const [vendorToEdit, setVendorToEdit] = useState<FinanceVendor | null>(null);

  // Filter accessible sites
  const availableProperties = canAccessAllSites()
    ? properties
    : properties.filter(p => p.id === assignedSite || p.name === assignedSite);

  const loadData = async () => {
    setIsLoading(true);
    try {
      const [billsData, vendorsData] = await Promise.all([
        financeService.getBills(),
        financeService.getVendors()
      ]);
      setBills(billsData);
      setVendors(vendorsData);
    } catch (err) {
      console.error('Failed to load finance data:', err);
    } finally {
      setIsLoading(false);
    }
  };

  useEffect(() => {
    loadData();
  }, []);

  // Filtered Bills
  const filteredBills = useMemo(() => {
    return bills.filter(bill => {
      // Tab filter
      if (activeTab === 'awaiting_approval') {
        if (bill.status !== 'submitted' && bill.status !== 'under_review' && bill.status !== 'awaiting_approval') return false;
      } else if (activeTab === 'verification') {
        if (bill.status !== 'verification_pending' && bill.status !== 'query_raised') return false;
      } else if (activeTab === 'reconciliation') {
        if (bill.status !== 'reconciliation_pending' && bill.status !== 'approved') return false;
      } else if (activeTab === 'payments') {
        if (bill.status !== 'payment_pending' && bill.status !== 'partially_paid' && bill.status !== 'paid') return false;
      }

      // Site filter
      if (selectedSite !== 'all' && bill.siteId !== selectedSite) return false;

      // Status filter
      if (selectedStatus !== 'all' && bill.status !== selectedStatus) return false;

      // Type filter
      if (selectedType !== 'all' && bill.billType !== selectedType) return false;

      // Search
      if (searchQuery.trim()) {
        const q = searchQuery.toLowerCase();
        const matchesNumber = bill.billNumber.toLowerCase().includes(q);
        const matchesVendor = (bill.vendorName || '').toLowerCase().includes(q);
        const matchesSite = (bill.siteName || '').toLowerCase().includes(q);
        const matchesDesc = (bill.description || '').toLowerCase().includes(q);
        const matchesPO = (bill.purchaseReference || '').toLowerCase().includes(q);
        if (!matchesNumber && !matchesVendor && !matchesSite && !matchesDesc && !matchesPO) return false;
      }

      return true;
    });
  }, [bills, activeTab, selectedSite, selectedStatus, selectedType, searchQuery]);

  // Metrics
  const metrics = useMemo(() => {
    const awaitingApproval = bills.filter(b => ['submitted', 'under_review', 'awaiting_approval'].includes(b.status));
    const approvedPendingPay = bills.filter(b => ['approved', 'payment_pending'].includes(b.status));
    const paidBills = bills.filter(b => ['paid', 'reconciled'].includes(b.status));
    const queryBills = bills.filter(b => b.status === 'query_raised');
    const reconciliationPending = bills.filter(b => b.status === 'reconciliation_pending' || b.status === 'approved');

    const totalAwaitingAmount = awaitingApproval.reduce((sum, b) => sum + b.totalAmount, 0);
    const totalApprovedAmount = approvedPendingPay.reduce((sum, b) => sum + b.totalAmount, 0);
    const totalPaidAmount = paidBills.reduce((sum, b) => sum + b.totalAmount, 0);

    return {
      awaitingCount: awaitingApproval.length,
      awaitingAmount: totalAwaitingAmount,
      approvedCount: approvedPendingPay.length,
      approvedAmount: totalApprovedAmount,
      paidAmount: totalPaidAmount,
      queryCount: queryBills.length,
      recCount: reconciliationPending.length
    };
  }, [bills]);

  const openBillDetail = (billId: string) => {
    setSelectedBillId(billId);
    setIsDetailModalOpen(true);
  };

  const statusBadge = (status: FinanceBillStatus) => {
    switch (status) {
      case 'approved':
        return <span className="px-2 py-0.5 text-[10px] font-bold rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200 uppercase">Approved</span>;
      case 'paid':
        return <span className="px-2 py-0.5 text-[10px] font-bold rounded-full bg-blue-100 text-blue-800 border border-blue-200 uppercase">Paid</span>;
      case 'partially_paid':
        return <span className="px-2 py-0.5 text-[10px] font-bold rounded-full bg-sky-100 text-sky-800 border border-sky-200 uppercase">Partially Paid</span>;
      case 'rejected':
        return <span className="px-2 py-0.5 text-[10px] font-bold rounded-full bg-rose-100 text-rose-800 border border-rose-200 uppercase">Rejected</span>;
      case 'query_raised':
        return <span className="px-2 py-0.5 text-[10px] font-bold rounded-full bg-amber-100 text-amber-800 border border-amber-200 uppercase">Query Raised</span>;
      case 'submitted':
      case 'under_review':
      case 'awaiting_approval':
        return <span className="px-2 py-0.5 text-[10px] font-bold rounded-full bg-purple-100 text-purple-800 border border-purple-200 uppercase">Review Pending</span>;
      case 'reconciled':
        return <span className="px-2 py-0.5 text-[10px] font-bold rounded-full bg-teal-100 text-teal-800 border border-teal-200 uppercase">Reconciled</span>;
      default:
        return <span className="px-2 py-0.5 text-[10px] font-bold rounded-full bg-gray-100 text-gray-700 border border-gray-200 uppercase">{status}</span>;
    }
  };

  const handleExportCSV = () => {
    const headers = ['Bill Number', 'Site', 'Vendor', 'Type', 'Date', 'Due Date', 'Total (£)', 'VAT (£)', 'Status', 'Submitted By'];
    const rows = filteredBills.map(b => [
      b.billNumber,
      b.siteName || b.siteId,
      b.vendorName || 'Direct',
      b.billType,
      b.billDate,
      b.dueDate || '',
      b.totalAmount.toFixed(2),
      b.taxAmount.toFixed(2),
      b.status,
      b.submitterName || b.submittedBy
    ]);

    const csvContent = 'data:text/csv;charset=utf-8,' + [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
    const encodedUri = encodeURI(csvContent);
    const link = document.createElement('a');
    link.setAttribute('href', encodedUri);
    link.setAttribute('download', `SDTracker_Finance_Bills_${new Date().toISOString().split('T')[0]}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  return (
    <div className="space-y-6">
      {/* Top Header Banner */}
      <div className="bg-white rounded-xl border border-gray-200 p-5 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div>
          <div className="flex items-center gap-2">
            <div className="w-8 h-8 rounded-lg bg-teal-50 border border-teal-200 flex items-center justify-center text-teal-700">
              <FileText className="w-4 h-4" />
            </div>
            <h1 className="text-xl font-bold text-gray-900 tracking-tight">Finance Management & Invoicing</h1>
          </div>
          <p className="text-xs text-gray-500 mt-1">
            Multi-site bill submission, private document storage, configurable approvals, manual reconciliation, and Finance sign-off.
          </p>
        </div>

        <div className="flex items-center gap-2.5 w-full sm:w-auto">
          <button
            type="button"
            onClick={loadData}
            title="Refresh"
            className="p-2 text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-lg border border-gray-200 transition-colors"
          >
            <RefreshCw className={`w-4 h-4 ${isLoading ? 'animate-spin' : ''}`} />
          </button>
          <button
            type="button"
            onClick={handleExportCSV}
            className="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-semibold text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors shadow-sm"
          >
            <Download className="w-3.5 h-3.5" />
            Export CSV
          </button>
          <button
            type="button"
            onClick={() => {
              setBillToEdit(null);
              setIsBillModalOpen(true);
            }}
            className="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-white bg-teal-600 hover:bg-teal-700 rounded-lg shadow-sm transition-colors shrink-0"
          >
            <Plus className="w-4 h-4" />
            Submit New Bill
          </button>
        </div>
      </div>

      {/* KPI Cards */}
      <div className="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div className="bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
          <div className="flex items-center justify-between">
            <span className="text-[10px] font-bold uppercase text-purple-700 tracking-wider">Awaiting Finance</span>
            <Clock className="w-4 h-4 text-purple-500" />
          </div>
          <div className="mt-2 flex items-baseline gap-2">
            <span className="text-xl font-extrabold text-gray-900">£{metrics.awaitingAmount.toFixed(2)}</span>
            <span className="text-xs text-gray-500 font-medium">({metrics.awaitingCount} bills)</span>
          </div>
        </div>

        <div className="bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
          <div className="flex items-center justify-between">
            <span className="text-[10px] font-bold uppercase text-emerald-700 tracking-wider">Approved Pending Pay</span>
            <CheckCircle className="w-4 h-4 text-emerald-500" />
          </div>
          <div className="mt-2 flex items-baseline gap-2">
            <span className="text-xl font-extrabold text-gray-900">£{metrics.approvedAmount.toFixed(2)}</span>
            <span className="text-xs text-gray-500 font-medium">({metrics.approvedCount})</span>
          </div>
        </div>

        <div className="bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
          <div className="flex items-center justify-between">
            <span className="text-[10px] font-bold uppercase text-blue-700 tracking-wider">Total Disbursed</span>
            <CreditCard className="w-4 h-4 text-blue-500" />
          </div>
          <div className="mt-2 flex items-baseline gap-2">
            <span className="text-xl font-extrabold text-gray-900">£{metrics.paidAmount.toFixed(2)}</span>
          </div>
        </div>

        <div className="bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
          <div className="flex items-center justify-between">
            <span className="text-[10px] font-bold uppercase text-amber-700 tracking-wider">Open Queries</span>
            <HelpCircle className="w-4 h-4 text-amber-500" />
          </div>
          <div className="mt-2 flex items-baseline gap-2">
            <span className="text-xl font-extrabold text-gray-900">{metrics.queryCount}</span>
            <span className="text-xs text-gray-500 font-medium">pending reply</span>
          </div>
        </div>
      </div>

      {/* Tabs & Filters Container */}
      <div className="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        {/* Navigation Sub-tabs */}
        <div className="px-4 py-2 border-b border-gray-200 bg-gray-50/70 flex items-center gap-1 overflow-x-auto text-xs font-semibold">
          <button
            onClick={() => setActiveTab('all')}
            className={`px-3 py-2 rounded-lg transition-colors whitespace-nowrap ${
              activeTab === 'all' ? 'bg-white text-teal-700 shadow-sm border border-gray-200' : 'text-gray-600 hover:text-gray-900'
            }`}
          >
            All Bills ({bills.length})
          </button>
          <button
            onClick={() => setActiveTab('awaiting_approval')}
            className={`px-3 py-2 rounded-lg transition-colors whitespace-nowrap flex items-center gap-1.5 ${
              activeTab === 'awaiting_approval' ? 'bg-white text-teal-700 shadow-sm border border-gray-200' : 'text-gray-600 hover:text-gray-900'
            }`}
          >
            Awaiting Approval
            {metrics.awaitingCount > 0 && (
              <span className="px-1.5 py-0.2 rounded-full bg-purple-100 text-purple-800 text-[10px] font-bold">
                {metrics.awaitingCount}
              </span>
            )}
          </button>
          <button
            onClick={() => setActiveTab('verification')}
            className={`px-3 py-2 rounded-lg transition-colors whitespace-nowrap flex items-center gap-1.5 ${
              activeTab === 'verification' ? 'bg-white text-teal-700 shadow-sm border border-gray-200' : 'text-gray-600 hover:text-gray-900'
            }`}
          >
            Verification & Queries
            {metrics.queryCount > 0 && (
              <span className="px-1.5 py-0.2 rounded-full bg-amber-100 text-amber-800 text-[10px] font-bold">
                {metrics.queryCount}
              </span>
            )}
          </button>
          <button
            onClick={() => setActiveTab('reconciliation')}
            className={`px-3 py-2 rounded-lg transition-colors whitespace-nowrap ${
              activeTab === 'reconciliation' ? 'bg-white text-teal-700 shadow-sm border border-gray-200' : 'text-gray-600 hover:text-gray-900'
            }`}
          >
            Manual Reconciliation ({metrics.recCount})
          </button>
          <button
            onClick={() => setActiveTab('payments')}
            className={`px-3 py-2 rounded-lg transition-colors whitespace-nowrap ${
              activeTab === 'payments' ? 'bg-white text-teal-700 shadow-sm border border-gray-200' : 'text-gray-600 hover:text-gray-900'
            }`}
          >
            Payment Tracking
          </button>
          <button
            onClick={() => setActiveTab('vendors')}
            className={`px-3 py-2 rounded-lg transition-colors whitespace-nowrap ${
              activeTab === 'vendors' ? 'bg-white text-teal-700 shadow-sm border border-gray-200' : 'text-gray-600 hover:text-gray-900'
            }`}
          >
            Vendor Master ({vendors.length})
          </button>
        </div>

        {/* Filter Bar (Bills View) */}
        {activeTab !== 'vendors' && (
          <div className="p-4 border-b border-gray-200 flex flex-col md:flex-row items-center justify-between gap-3 bg-white">
            <div className="flex flex-wrap items-center gap-2 w-full md:w-auto">
              <div className="relative flex-1 sm:w-64">
                <Search className="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2" />
                <input
                  type="text"
                  value={searchQuery}
                  onChange={e => setSearchQuery(e.target.value)}
                  placeholder="Search bill #, PO, vendor, description..."
                  className="w-full text-xs rounded-lg border border-gray-300 pl-9 pr-3 py-1.5 focus:ring-2 focus:ring-teal-500"
                />
              </div>

              <select
                value={selectedSite}
                onChange={e => setSelectedSite(e.target.value)}
                className="text-xs rounded-lg border border-gray-300 px-3 py-1.5 bg-white"
              >
                <option value="all">All Properties</option>
                {availableProperties.map(p => (
                  <option key={p.id} value={p.id}>{p.name}</option>
                ))}
              </select>

              <select
                value={selectedStatus}
                onChange={e => setSelectedStatus(e.target.value)}
                className="text-xs rounded-lg border border-gray-300 px-3 py-1.5 bg-white"
              >
                <option value="all">All Statuses</option>
                <option value="submitted">Submitted</option>
                <option value="under_review">Under Review</option>
                <option value="query_raised">Query Raised</option>
                <option value="approved">Approved</option>
                <option value="rejected">Rejected</option>
                <option value="paid">Paid</option>
                <option value="partially_paid">Partially Paid</option>
              </select>

              <select
                value={selectedType}
                onChange={e => setSelectedType(e.target.value)}
                className="text-xs rounded-lg border border-gray-300 px-3 py-1.5 bg-white"
              >
                <option value="all">All Bill Types</option>
                <option value="vendor_invoice">Vendor Invoice</option>
                <option value="credit_card_expense">Credit Card Expense</option>
                <option value="other_expense">Other Direct Expense</option>
              </select>
            </div>

            {(searchQuery || selectedSite !== 'all' || selectedStatus !== 'all' || selectedType !== 'all') && (
              <button
                type="button"
                onClick={() => {
                  setSearchQuery('');
                  setSelectedSite('all');
                  setSelectedStatus('all');
                  setSelectedType('all');
                }}
                className="text-xs text-teal-600 hover:text-teal-800 font-semibold"
              >
                Reset Filters
              </button>
            )}
          </div>
        )}

        {/* Tab 1-5: Bills Data Table */}
        {activeTab !== 'vendors' ? (
          <div className="overflow-x-auto">
            <table className="w-full text-left text-xs">
              <thead className="bg-gray-100/60 text-gray-600 font-semibold border-b border-gray-200">
                <tr>
                  <th className="py-3 px-4">Bill Number</th>
                  <th className="py-3 px-3">Property / Site</th>
                  <th className="py-3 px-3">Vendor / Expense</th>
                  <th className="py-3 px-3">Invoice Date</th>
                  <th className="py-3 px-3">Due Date</th>
                  <th className="py-3 px-3 text-right">Subtotal</th>
                  <th className="py-3 px-3 text-right">VAT</th>
                  <th className="py-3 px-4 text-right">Total (£)</th>
                  <th className="py-3 px-3">Status</th>
                  <th className="py-3 px-4 text-center">Actions</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-gray-100">
                {isLoading ? (
                  <tr>
                    <td colSpan={10} className="py-12 text-center text-gray-400">Loading bills...</td>
                  </tr>
                ) : filteredBills.length > 0 ? (
                  filteredBills.map(bill => (
                    <tr
                      key={bill.id}
                      onClick={() => openBillDetail(bill.id)}
                      className="hover:bg-teal-50/30 cursor-pointer transition-colors"
                    >
                      <td className="py-3 px-4 font-bold text-gray-900">
                        {bill.billNumber}
                        {bill.purchaseReference && (
                          <span className="block text-[10px] font-normal text-gray-400">PO: {bill.purchaseReference}</span>
                        )}
                      </td>
                      <td className="py-3 px-3 text-gray-700">{bill.siteName || bill.siteId}</td>
                      <td className="py-3 px-3 font-medium text-gray-800">
                        {bill.vendorName || (bill.billType === 'credit_card_expense' ? 'Credit Card' : 'Direct Expense')}
                      </td>
                      <td className="py-3 px-3 text-gray-600">{bill.billDate}</td>
                      <td className="py-3 px-3 text-gray-600">{bill.dueDate || '—'}</td>
                      <td className="py-3 px-3 text-right text-gray-600">£{bill.subtotal.toFixed(2)}</td>
                      <td className="py-3 px-3 text-right text-gray-600">£{bill.taxAmount.toFixed(2)}</td>
                      <td className="py-3 px-4 text-right font-extrabold text-teal-800">£{bill.totalAmount.toFixed(2)}</td>
                      <td className="py-3 px-3">{statusBadge(bill.status)}</td>
                      <td className="py-3 px-4 text-center" onClick={e => e.stopPropagation()}>
                        <button
                          type="button"
                          onClick={() => openBillDetail(bill.id)}
                          className="p-1.5 text-teal-600 hover:text-teal-800 hover:bg-teal-50 rounded-lg transition-colors"
                          title="View Details"
                        >
                          <Eye className="w-4 h-4" />
                        </button>
                      </td>
                    </tr>
                  ))
                ) : (
                  <tr>
                    <td colSpan={10} className="py-12 text-center text-gray-400">
                      No bills match the selected criteria.
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        ) : (
          /* Tab 6: Vendor Master Table */
          <div className="p-4 space-y-4">
            <div className="flex items-center justify-between">
              <div>
                <h3 className="text-xs font-bold text-gray-800 uppercase tracking-wider">Authorized Vendors & Suppliers</h3>
                <p className="text-[11px] text-gray-500">Master supplier directory for multi-site procurement and invoicing.</p>
              </div>
              <button
                type="button"
                onClick={() => {
                  setVendorToEdit(null);
                  setIsVendorModalOpen(true);
                }}
                className="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-white bg-teal-600 hover:bg-teal-700 rounded-lg shadow-sm"
              >
                <Plus className="w-3.5 h-3.5" />
                Add Vendor
              </button>
            </div>

            <div className="rounded-xl border border-gray-200 overflow-hidden">
              <table className="w-full text-left text-xs">
                <thead className="bg-gray-100/60 text-gray-600 font-semibold border-b border-gray-200">
                  <tr>
                    <th className="py-3 px-4">Vendor Name</th>
                    <th className="py-3 px-3">Account Code</th>
                    <th className="py-3 px-3">Contact Email</th>
                    <th className="py-3 px-3">Contact Phone</th>
                    <th className="py-3 px-3">Status</th>
                    <th className="py-3 px-4 text-center">Actions</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-gray-100">
                  {vendors.length > 0 ? (
                    vendors.map(v => (
                      <tr key={v.id} className="hover:bg-gray-50">
                        <td className="py-3 px-4 font-bold text-gray-900">{v.vendorName}</td>
                        <td className="py-3 px-3 text-gray-600">{v.vendorReference || '—'}</td>
                        <td className="py-3 px-3 text-gray-600">{v.contactEmail || '—'}</td>
                        <td className="py-3 px-3 text-gray-600">{v.contactPhone || '—'}</td>
                        <td className="py-3 px-3">
                          <span className={`px-2 py-0.5 rounded text-[10px] font-semibold uppercase ${
                            v.status === 'active' ? 'bg-emerald-100 text-emerald-800' : 'bg-gray-100 text-gray-600'
                          }`}>
                            {v.status}
                          </span>
                        </td>
                        <td className="py-3 px-4 text-center">
                          <button
                            type="button"
                            onClick={() => {
                              setVendorToEdit(v);
                              setIsVendorModalOpen(true);
                            }}
                            className="text-xs font-semibold text-teal-600 hover:text-teal-800"
                          >
                            Edit
                          </button>
                        </td>
                      </tr>
                    ))
                  ) : (
                    <tr>
                      <td colSpan={6} className="py-8 text-center text-gray-400">
                        No vendors registered in directory.
                      </td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>
        )}
      </div>

      {/* Modals */}
      <FinanceBillModal
        isOpen={isBillModalOpen}
        onClose={() => setIsBillModalOpen(false)}
        onSuccess={loadData}
        billToEdit={billToEdit}
        vendors={vendors}
      />

      <FinanceBillDetailModal
        isOpen={isDetailModalOpen}
        billId={selectedBillId}
        onClose={() => {
          setIsDetailModalOpen(false);
          setSelectedBillId(null);
        }}
        onRefresh={loadData}
      />

      <FinanceVendorModal
        isOpen={isVendorModalOpen}
        onClose={() => {
          setIsVendorModalOpen(false);
          setVendorToEdit(null);
        }}
        onSuccess={loadData}
        vendorToEdit={vendorToEdit}
      />
    </div>
  );
};
