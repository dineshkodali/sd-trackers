{
  "note": "Design tokens for the SDTracker iOS app. Colours are semantic; map them to Asset Catalog colour sets with light and dark values.",
  "colour": {
    "brand": {
      "tint": "#0F766E",
      "tintSoft": "#E6F4F2",
      "teal": "#0D9488",
      "note": "Matches the web app teal (#0D9488 accent, #0F766E on light surfaces for contrast)."
    },
    "background": {
      "grouped": "#F2F2F7",
      "card": "#FFFFFF",
      "separator": "#E5E5EA"
    },
    "text": {
      "primary": "#1C1C1E",
      "secondary": "#636366",
      "tertiary": "#8E8E93",
      "onTint": "#FFFFFF"
    },
    "status": {
      "success": "#34C759",
      "warning": "#FF9500",
      "danger": "#FF3B30",
      "info": "#007AFF",
      "special": "#AF52DE",
      "neutral": "#8E8E93"
    },
    "statusSoft": {
      "green": {
        "background": "#E8F8EC",
        "foreground": "#1E7A38"
      },
      "orange": {
        "background": "#FFF3E0",
        "foreground": "#B25E00"
      },
      "red": {
        "background": "#FFEAE8",
        "foreground": "#C6281C"
      },
      "blue": {
        "background": "#E5F1FF",
        "foreground": "#0B63CE"
      },
      "purple": {
        "background": "#F3E8FB",
        "foreground": "#8231B0"
      },
      "gray": {
        "background": "#EFEFF4",
        "foreground": "#575759"
      },
      "teal": {
        "background": "#E6F4F2",
        "foreground": "#0F766E"
      },
      "yellow": {
        "background": "#FFF8D6",
        "foreground": "#8A6D00"
      }
    }
  },
  "typography": {
    "note": "San Francisco via Dynamic Type text styles. Sizes are the default (Large) content size.",
    "largeTitle": {
      "size": 34,
      "weight": "bold"
    },
    "title": {
      "size": 28,
      "weight": "bold"
    },
    "headline": {
      "size": 17,
      "weight": "semibold"
    },
    "body": {
      "size": 17,
      "weight": "regular"
    },
    "cardTitle": {
      "size": 16,
      "weight": "semibold"
    },
    "callout": {
      "size": 15,
      "weight": "regular"
    },
    "subheadline": {
      "size": 13,
      "weight": "regular"
    },
    "caption": {
      "size": 12,
      "weight": "regular"
    },
    "badge": {
      "size": 12,
      "weight": "semibold"
    }
  },
  "spacing": {
    "unit": 4,
    "scale": [
      4,
      8,
      12,
      16,
      20,
      24,
      32
    ],
    "screenMargin": 16,
    "cardPadding": 14,
    "sectionGap": 18,
    "rowMinHeight": 44
  },
  "radius": {
    "card": 14,
    "group": 12,
    "button": 14,
    "field": 11,
    "chip": 17,
    "badge": 11,
    "sheet": 22
  },
  "elevation": {
    "card": "0 1px 2px rgba(0,0,0,.04)",
    "sheet": "0 -4px 30px rgba(0,0,0,.2)"
  },
  "sizes": {
    "tabBar": 49,
    "navBarInline": 44,
    "navBarLarge": 96,
    "touchTarget": 44,
    "iconInRow": 17,
    "iconTab": 25
  },
  "motion": {
    "push": "0.35s iOS default",
    "sheet": "spring",
    "reduceMotion": "respect Reduce Motion"
  }
}